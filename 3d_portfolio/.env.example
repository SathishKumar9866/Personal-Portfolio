# EmailJS — makes the contact form send email in-page.
# Without these, the form safely falls back to opening the visitor's mail client.
# Get the values from https://dashboard.emailjs.com/ — see docs/EMAIL-SETUP.md.
#
# Copy this file to .env.local and fill in the values (never commit real keys).

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
