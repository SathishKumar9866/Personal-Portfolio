# Copy to .env.local (git-ignored) for local dev, or set in Vercel for deploy.

# Microsoft Clarity — free heatmaps + session recordings (src/components/Clarity.tsx).
# Without it, no analytics script loads (zero tracking). Create a project at
# https://clarity.microsoft.com and paste its ID here.
NEXT_PUBLIC_CLARITY_ID=

# Public site origin — drives canonical URL, OpenGraph, robots, sitemap.
# e.g. https://sathish-kumar.vercel.app
NEXT_PUBLIC_SITE_URL=
